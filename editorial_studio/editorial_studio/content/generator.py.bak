from __future__ import annotations
import json
import uuid
from dataclasses import dataclass, field
from datetime import datetime
from pathlib import Path
from typing import Any, Optional
import re

from editorial_studio.core.models import (
    ContentBlock,
    ContentType,
    Manuscript,
    SemanticRole,
)
from editorial_studio.content.ingestion import ManuscriptIngester
from editorial_studio.core.config import load_config


@dataclass
class Source:
    id: str
    url: str = ""
    title: str = ""
    publisher: str = ""
    access_date: str = ""
    relevant_passage: str = ""
    claims_supported: list[str] = field(default_factory=list)
    confidence: float = 0.0
    verification_status: str = "unverified"
    metadata: dict[str, Any] = field(default_factory=dict)

    def __post_init__(self):
        if not self.id:
            self.id = f"src_{uuid.uuid4().hex[:12]}"


@dataclass
class ChapterPlan:
    number: int
    title: str
    learning_objective: str
    key_topics: list[str]
    estimated_words: int
    required_sources: list[str] = field(default_factory=list)
    visual_elements: list[dict[str, Any]] = field(default_factory=list)
    exercises: list[str] = field(default_factory=list)


@dataclass
class ManuscriptPlan:
    title: str
    subtitle: str = ""
    description: str = ""
    audience: str = ""
    purpose: str = ""
    tone: str = ""
    chapters: list[ChapterPlan] = field(default_factory=list)
    total_estimated_words: int = 0
    glossary_terms: list[str] = field(default_factory=list)
    appendices: list[dict[str, Any]] = field(default_factory=list)


@dataclass
class GenerationResult:
    manuscript: Manuscript
    plan: ManuscriptPlan
    sources: list[Source]
    warnings: list[str]
    errors: list[str]
    stats: dict[str, Any]


class ManuscriptGenerator:
    def __init__(self, llm_provider: str = "local"):
        self.llm_provider = llm_provider
        self.config = load_config().data
        self.ingester = ManuscriptIngester()
        self.sources: list[Source] = []
        self.generation_log: list[dict[str, Any]] = []

    def generate_from_topic(
        self,
        topic: str,
        audience: str = "General professional audience",
        purpose: str = "Inform and guide readers through comprehensive content",
        tone: str = "professional, accessible, engaging",
        chapter_count: int = 10,
        target_words: int = 10000,
        user_instructions: str = "",
        existing_sources: list[Source] | None = None,
    ) -> GenerationResult:
        self.sources = existing_sources or []
        self.generation_log = []

        # Phase 1: Create manuscript plan
        plan = self._create_manuscript_plan(
            topic, audience, purpose, tone, chapter_count, target_words, user_instructions
        )

        # Phase 2: Research and gather sources for each chapter
        self._research_chapters(plan, topic)

        # Phase 3: Generate each chapter
        manuscript = self._generate_chapters(plan, topic, audience, tone, user_instructions)

        # Phase 4: Generate front/back matter
        manuscript = self._generate_front_matter(manuscript, plan)
        manuscript = self._generate_back_matter(manuscript, plan)

        # Phase 5: Validate and enrich
        manuscript = self._validate_and_enrich(manuscript, plan)

        stats = {
            "word_count": manuscript.total_word_count(),
            "block_count": len(manuscript.content_blocks),
            "chapters": max((b.chapter for b in manuscript.content_blocks), default=0),
            "source_count": len(self.sources),
        }

        return GenerationResult(
            manuscript=manuscript,
            plan=plan,
            sources=self.sources,
            warnings=[],
            errors=[],
            stats=stats,
        )

    def _create_manuscript_plan(
        self,
        topic: str,
        audience: str,
        purpose: str,
        tone: str,
        chapter_count: int,
        target_words: int,
        user_instructions: str,
    ) -> ManuscriptPlan:
        # This would use an LLM to create a detailed chapter plan
        # For now, create a structured plan based on the topic
        words_per_chapter = target_words // max(1, chapter_count)

        # Generate chapter plans based on topic analysis
        chapters = self._generate_chapter_plans(topic, chapter_count, words_per_chapter)

        plan = ManuscriptPlan(
            title=topic,
            audience=audience,
            purpose=purpose,
            tone=tone,
            chapters=chapters,
            total_estimated_words=target_words,
        )

        self._log_step("plan_created", {"topic": topic, "chapters": len(chapters)})
        return plan

def _generate_chapter_plans(
        self, topic: str, chapter_count: int, words_per_chapter: int
    ) -> list[ChapterPlan]:
        # This would use an LLM to generate detailed chapter plans
        # For now, create a structured plan based on the topic
        chapters = []

        # Define chapter structures for land investment topic
        land_investment_chapters = [
            {
                "title": "Understanding the U.S. Land Market and Types of Land",
                "objective": "Establish fundamental concepts and terminology of land investment",
                "topics": ["Market overview and size", "Land classification systems", "Investment thesis by land type", "Key market drivers and cycles"],
            },
            {
                "title": "Land Valuation Frameworks: Market, Recreational, Agricultural, and Mitigation",
                "objective": "Master valuation methodologies for different land categories",
                "topics": ["Comparable sales analysis", "Income approach for agricultural land", "Recreational land valuation", "Mitigation banking valuation"],
            },
            {
                "title": "Finding On-Market and Off-Market Acquisition Opportunities",
                "objective": "Develop systematic deal sourcing strategies across channels",
                "topics": ["MLS and public listing strategies", "Direct mail and skip tracing", "Networking and broker relationships", "Public records and tax delinquency"],
            },
            {
                "title": "Seller Research, Outreach, Negotiation, and Acquisition Structures",
                "objective": "Execute effective seller engagement and deal structuring",
                "topics": ["Seller motivation analysis", "Outreach scripts and sequences", "Negotiation frameworks", "Creative acquisition structures"],
            },
            {
                "title": "Title, Ownership, Easements, Access, Zoning, and Land-Use Diligence",
                "objective": "Conduct comprehensive legal and regulatory due diligence",
                "topics": ["Title search and insurance", "Easement and access verification", "Zoning and land-use analysis", "Encumbrance identification"],
            },
            {
                "title": "Water, Soil, Flood, Environmental, and Jurisdictional Risk Assessment",
                "objective": "Evaluate physical and environmental risk factors",
                "topics": ["Water rights and availability", "Soil quality and percolation", "Flood zone and FEMA analysis", "Environmental contamination screening"],
            },
            {
                "title": "Valuation Methodology, Comps, Costs, and Financial Underwriting",
                "objective": "Build rigorous financial models for land acquisitions",
                "topics": ["Comparable sales selection and adjustment", "Acquisition cost modeling", "Carrying cost projections", "Sensitivity analysis and IRR"],
            },
            {
                "title": "Transaction Structures: Owner Financing, Options, and Creative Structures",
                "objective": "Structure deals that align incentives and minimize capital requirements",
                "topics": ["Owner financing mechanics", "Option agreements and lease-options", "Joint ventures and partnerships", "1031 exchange considerations"],
            },
            {
                "title": "Land Stabilization, Improvements, and Value-Add Strategies",
                "objective": "Implement practical improvements that increase land value",
                "topics": ["Access and road improvements", "Utilities and infrastructure", "Clearing, grading, and drainage", "Permitting and entitlement basics"],
            },
            {
                "title": "Exit Strategies: Resale, Cash Flow, and Portfolio Management",
                "objective": "Design and execute profitable exit strategies",
                "topics": ["Retail resale marketing", "Seller financing as exit", "Long-term hold and lease strategies", "Portfolio optimization and 1031 exchanges"],
            },
            {
                "title": "The Complete Acquisition Checklist and Deal Review Framework",
                "objective": "Synthesize all learning into a repeatable, institutional-quality process",
                "topics": ["Master due diligence checklist", "Deal scoring and scoring model", "Investment committee memo template", "Ongoing portfolio monitoring"],
            },
            {
                "title": "Worked Example: A Complete Hypothetical Land Transaction",
                "objective": "Apply all concepts to a realistic scenario with transparent assumptions",
                "topics": ["Scenario setup and assumptions", "Step-by-step underwriting", "Sensitivity analysis", "Lessons learned and key takeaways"],
            },
        ]

        # Use provided chapter_count or default to all chapters
        chapters_to_use = land_investment_chapters[:chapter_count]

        for i, ch_data in enumerate(chapters_to_use):
            chapter = ChapterPlan(
                number=i + 1,
                title=ch_data["title"],
                learning_objective=ch_data["objective"],
                key_topics=ch_data["topics"],
                estimated_words=words_per_chapter,
                visual_elements=[
                    {"type": "diagram", "description": f"Process flow for {ch_data['topics'][0]}"},
                    {"type": "table", "description": f"Comparison table for {ch_data['topics'][1]}"},
                    {"type": "checklist", "description": f"Checklist for {ch_data['topics'][2]}"},
                ],
                exercises=[
                    f"Exercise: Apply {ch_data['topics'][0]} to a property in your target market",
                    f"Worksheet: {ch_data['topics'][1]} assessment for a sample property",
                    f"Analysis: Evaluate {ch_data['topics'][2]} for a hypothetical parcel",
                ],
            )
            chapters.append(chapter)

        return chapters

    def _research_chapters(self, plan: ManuscriptPlan, topic: str):
        # This would use web search tools to gather sources
        # For now, create placeholder sources
        for chapter in plan.chapters:
            for topic_name in chapter.key_topics:
                source = Source(
                    id=f"src_{uuid.uuid4().hex[:10]}",
                    title=f"Research on {topic_name}",
                    url="",
                    publisher="Internal Research",
                    access_date=datetime.now().strftime("%Y-%m-%d"),
                    relevant_passage=f"Key findings on {topic_name} for {plan.title}",
                    claims_supported=[f"{topic_name} fundamentals", f"{topic_name} best practices"],
                    confidence=0.7,
                    verification_status="pending",
                )
                self.sources.append(source)
                chapter.required_sources.append(source.id)

        self._log_step("research_complete", {"source_count": len(self.sources)})

    def _generate_chapters(
        self,
        plan: ManuscriptPlan,
        topic: str,
        audience: str,
        tone: str,
        user_instructions: str,
    ) -> Manuscript:
        blocks: list[ContentBlock] = []
        block_counter = 0

        def next_block_id():
            nonlocal block_counter
            block_counter += 1
            return f"cb_{uuid.uuid4().hex[:10]}_{block_counter:04d}"

        def make_block(content: str, ctype: ContentType, role: SemanticRole, chapter: int, section: int = 0, subsection: int = 0, level: int = 0, metadata: dict | None = None) -> ContentBlock:
            return ContentBlock(
                id=next_block_id(),
                content=content,
                content_type=ctype,
                semantic_role=role,
                chapter=chapter,
                section=section,
                subsection=subsection,
                order=block_counter,
                level=level,
                metadata=metadata or {},
            )

        for chapter in plan.chapters:
            # Chapter heading
            blocks.append(make_block(
                chapter.title, ContentType.HEADING, SemanticRole.CHAPTER,
                chapter.number, 0, 0, level=1
            ))

            # Chapter introduction
            intro = self._generate_chapter_intro(chapter, topic, audience, tone)
            blocks.append(make_block(
                intro, ContentType.PARAGRAPH, SemanticRole.BODY,
                chapter.number, 0, 0
            ))

            # Learning objective callout
            blocks.append(make_block(
                f"Learning Objective: {chapter.learning_objective}",
                ContentType.CALLOUT, SemanticRole.NOTE,
                chapter.number, 0, 0,
                metadata={"kind": "learning_objective"}
            ))

            # Sections for each key topic
            for section_idx, topic_name in enumerate(chapter.key_topics, 1):
                section_content = self._generate_section_content(
                    topic_name, chapter, topic, audience, tone
                )

                blocks.append(make_block(
                    topic_name, ContentType.HEADING, SemanticRole.SECTION,
                    chapter.number, section_idx, 0, level=2
                ))

                blocks.append(make_block(
                    section_content, ContentType.PARAGRAPH, SemanticRole.BODY,
                    chapter.number, section_idx, 0
                ))

                # Add definition if appropriate
                if "definition" in topic_name.lower() or "concept" in topic_name.lower():
                    definition = self._generate_definition(topic_name, topic)
                    blocks.append(make_block(
                        definition, ContentType.DEFINITION, SemanticRole.BODY,
                        chapter.number, section_idx, 0
                    ))

                # Add worked example for practical topics
                if any(kw in topic_name.lower() for kw in ["process", "method", "strategy", "framework", "analysis"]):
                    example = self._generate_worked_example(topic_name, chapter, topic)
                    blocks.append(make_block(
                        example, ContentType.WORKED_EXAMPLE, SemanticRole.EXAMPLE,
                        chapter.number, section_idx, 0
                    ))

            # Chapter summary
            summary = self._generate_chapter_summary(chapter, topic)
            blocks.append(make_block(
                f"Summary: {summary}",
                ContentType.PARAGRAPH, SemanticRole.BODY,
                chapter.number, len(chapter.key_topics) + 1, 0
            ))

            # Exercises
            for exercise in chapter.exercises:
                blocks.append(make_block(
                    exercise, ContentType.EXERCISE, SemanticRole.EXERCISE,
                    chapter.number, len(chapter.key_topics) + 2, 0
                ))

        manuscript = Manuscript(
            id=f"ms_{uuid.uuid4().hex[:12]}",
            title=plan.title,
            author="AI Editorial Studio",
            description=plan.description,
            source_format="generated",
            content_blocks=blocks,
            metadata={"plan": plan.__dict__, "generation_log": self.generation_log},
        )

        self._log_step("chapters_generated", {"block_count": len(blocks)})
        return manuscript

    def _generate_chapter_intro(self, chapter: ChapterPlan, topic: str, audience: str, tone: str) -> str:
        return (
            f"This chapter explores {chapter.title.lower()}, a critical aspect of {topic}. "
            f"By the end of this chapter, you will {chapter.learning_objective.lower()}. "
            f"We will cover {len(chapter.key_topics)} key topics, each building on the previous "
            f"to give you a comprehensive understanding. Whether you are new to {topic} or "
            f"looking to deepen your expertise, this chapter provides the foundation you need."
        )

    def _generate_section_content(self, topic_name: str, chapter: ChapterPlan, book_topic: str, audience: str, tone: str) -> str:
        # This would use an LLM to generate detailed content
        # For now, generate structured placeholder content
        source_refs = [s for s in self.sources if any(topic_name.lower() in c.lower() for c in s.claims_supported)]
        source_text = ""
        if source_refs:
            source_text = f" Research indicates that {source_refs[0].relevant_passage[:200]}."

        return (
            f"{topic_name} is a fundamental component of {chapter.title.lower()}. "
            f"It encompasses several key aspects that every {audience.lower()} should understand. "
            f"First, the core principles involve understanding the underlying mechanics and drivers. "
            f"Second, practical application requires attention to context-specific factors. "
            f"Third, common pitfalls can be avoided through systematic approaches.{source_text} "
            f"Throughout this section, we will examine real-world applications and provide "
            f"actionable frameworks you can apply immediately."
        )

    def _generate_definition(self, term: str, context: str) -> str:
        return (
            f"Definition: {term} refers to the specific concept within {context} that "
            f"encompasses the essential characteristics, boundaries, and relationships "
            f"necessary for practical application. This definition distinguishes {term} "
            f"from related concepts by emphasizing its operational significance."
        )

    def _generate_worked_example(self, topic_name: str, chapter: ChapterPlan, book_topic: str) -> str:
        return (
            f"Worked Example: Consider a scenario where you need to apply {topic_name.lower()} "
            f"in a real {book_topic} situation. Let's walk through the step-by-step process: "
            f"1) Identify the key variables and constraints. 2) Apply the relevant framework. "
            f"3) Calculate the expected outcomes. 4) Validate against known benchmarks. "
            f"4) Adjust for context-specific factors. This example demonstrates how the "
            f"theoretical concepts translate into practical decision-making."
        )

    def _generate_chapter_summary(self, chapter: ChapterPlan, topic: str) -> str:
        topics = ", ".join(chapter.key_topics)
        return (
            f"In this chapter, we explored {chapter.title.lower()}, covering {topics}. "
            f"The key takeaway is that {chapter.learning_objective.lower()}. "
            f"Remember to apply the frameworks and checklists provided, and refer to the "
            f"exercises to reinforce your understanding. The next chapter will build on "
            f"these foundations."
        )

    def _generate_front_matter(self, manuscript: Manuscript, plan: ManuscriptPlan) -> Manuscript:
        front_blocks: list[ContentBlock] = []
        block_counter = len(manuscript.content_blocks)

        def next_block_id():
            nonlocal block_counter
            block_counter += 1
            return f"cb_{uuid.uuid4().hex[:10]}_{block_counter:04d}"

        def make_block(content: str, ctype: ContentType, role: SemanticRole, chapter: int = 0, section: int = 0, level: int = 0, metadata: dict | None = None) -> ContentBlock:
            return ContentBlock(
                id=next_block_id(),
                content=content,
                content_type=ctype,
                semantic_role=role,
                chapter=chapter,
                section=section,
                order=block_counter,
                level=level,
                metadata=metadata or {},
            )

        # Title page content
        front_blocks.append(make_block(
            plan.title, ContentType.HEADING, SemanticRole.TITLE,
            0, 0, level=1
        ))
        if plan.subtitle:
            front_blocks.append(make_block(
                plan.subtitle, ContentType.HEADING, SemanticRole.SUBTITLE,
                0, 0, level=2
            ))
        front_blocks.append(make_block(
            "A Comprehensive Guide", ContentType.PARAGRAPH, SemanticRole.BODY,
            0, 0
        ))
        front_blocks.append(make_block(
            manuscript.author, ContentType.PARAGRAPH, SemanticRole.AUTHOR,
            0, 0
        ))

        # Copyright page
        front_blocks.append(make_block(
            "Copyright", ContentType.HEADING, SemanticRole.BODY,
            0, 0, level=2
        ))
        front_blocks.append(make_block(
            f"© {datetime.now().year} {manuscript.author}. All rights reserved.",
            ContentType.PARAGRAPH, SemanticRole.BODY,
            0, 0
        ))

        # Preface
        front_blocks.append(make_block(
            "Preface", ContentType.HEADING, SemanticRole.FRONT_MATTER,
            0, 0, level=1
        ))
        front_blocks.append(make_block(
            f"This book was created to serve {plan.audience.lower()} who need "
            f"comprehensive guidance on {plan.title.lower()}. {plan.purpose}. "
            f"The tone is {plan.tone.lower()}, reflecting our commitment to "
            f"accessible yet authoritative content.",
            ContentType.PARAGRAPH, SemanticRole.BODY,
            0, 0
        ))

        # How to use this book
        front_blocks.append(make_block(
            "How to Use This Book", ContentType.HEADING, SemanticRole.BODY,
            0, 0, level=2
        ))
        front_blocks.append(make_block(
            "Each chapter begins with a clear learning objective and ends with a summary "
            "and practical exercises. Key concepts are highlighted in definition boxes. "
            "Worked examples demonstrate practical application. Chapter summaries and "
            "exercises reinforce learning. The appendices provide reference materials "
            "and templates for immediate use.",
            ContentType.PARAGRAPH, SemanticRole.BODY,
            0, 0
        ))

        # Adjust chapter numbers for existing blocks (shift by front matter offset)
        offset = len(front_blocks)
        for block in manuscript.content_blocks:
            block.chapter += 1  # Shift chapters to account for front matter
            block.order += offset

        manuscript.content_blocks = front_blocks + manuscript.content_blocks
        return manuscript

    def _generate_back_matter(self, manuscript: Manuscript, plan: ManuscriptPlan) -> Manuscript:
        back_blocks: list[ContentBlock] = []
        block_counter = len(manuscript.content_blocks)
        next_chapter = max((b.chapter for b in manuscript.content_blocks), default=0) + 1

        def next_block_id():
            nonlocal block_counter
            block_counter += 1
            return f"cb_{uuid.uuid4().hex[:10]}_{block_counter:04d}"

        def make_block(content: str, ctype: ContentType, role: SemanticRole, chapter: int, section: int = 0, level: int = 0, metadata: dict | None = None) -> ContentBlock:
            return ContentBlock(
                id=next_block_id(),
                content=content,
                content_type=ctype,
                semantic_role=role,
                chapter=chapter,
                section=section,
                order=block_counter,
                level=level,
                metadata=metadata or {},
            )

        # Glossary
        if plan.glossary_terms:
            back_blocks.append(make_block(
                "Glossary", ContentType.HEADING, SemanticRole.GLOSSARY,
                next_chapter, 0, level=1
            ))
            for term in plan.glossary_terms:
                back_blocks.append(make_block(
                    f"{term}: A key concept in {plan.title.lower()}. See relevant chapters for detailed explanation.",
                    ContentType.DEFINITION, SemanticRole.GLOSSARY,
                    next_chapter, 0
                ))
            next_chapter += 1

        # Appendices
        for idx, appendix in enumerate(plan.appendices):
            back_blocks.append(make_block(
                appendix.get("title", f"Appendix {idx + 1}"),
                ContentType.HEADING, SemanticRole.APPENDIX,
                next_chapter, 0, level=1
            ))
            back_blocks.append(make_block(
                appendix.get("content", f"Supplementary material: {appendix.get('description', '')}"),
                ContentType.PARAGRAPH, SemanticRole.APPENDIX,
                next_chapter, 0
            ))
            next_chapter += 1

        # References/Bibliography
        if self.sources:
            back_blocks.append(make_block(
                "References", ContentType.HEADING, SemanticRole.REFERENCE,
                next_chapter, 0, level=1
            ))
            for source in self.sources:
                ref_text = f"{source.title}. {source.publisher}, {source.access_date}."
                if source.url:
                    ref_text += f" Available at: {source.url}"
                back_blocks.append(make_block(
                    ref_text, ContentType.REFERENCE, SemanticRole.REFERENCE,
                    next_chapter, 0,
                    metadata={"source_id": source.id}
                ))
            next_chapter += 1

        # About the Author
        back_blocks.append(make_block(
            "About the Author", ContentType.HEADING, SemanticRole.BODY,
            next_chapter, 0, level=1
        ))
        back_blocks.append(make_block(
            f"{manuscript.author} is the author of this publication. "
            f"This content was generated by AI Editorial Studio with human oversight.",
            ContentType.PARAGRAPH, SemanticRole.BODY,
            next_chapter, 0
        ))

        manuscript.content_blocks.extend(back_blocks)
        return manuscript

    def _validate_and_enrich(self, manuscript: Manuscript, plan: ManuscriptPlan) -> Manuscript:
        # Check for missing sections
        chapters_covered = set(b.chapter for b in manuscript.content_blocks if b.chapter > 0)
        expected_chapters = set(range(1, len(plan.chapters) + 1 + 2))  # +2 for front matter
        missing = expected_chapters - chapters_covered
        if missing:
            print(f"Warning: Missing chapters: {missing}")

        # Enrich blocks with traceability
        for block in manuscript.content_blocks:
            if not block.traceability:
                block.traceability = {"generated_at": datetime.now().isoformat()}
            block.traceability["plan_id"] = plan.title

        return manuscript

    def _log_step(self, step: str, data: dict[str, Any]):
        self.generation_log.append({
            "step": step,
            "timestamp": datetime.now().isoformat(),
            "data": data,
        })


class ResearchEngine:
    """Handles web search and source management for manuscript generation."""

    def __init__(self):
        self.config = load_config().data
        self.sources: list[Source] = []

    def search(self, query: str, max_results: int = 10) -> list[Source]:
        """Search for sources on a topic. In production, this would call a search API."""
        # Placeholder implementation
        results = []
        for i in range(min(3, max_results)):
            source = Source(
                id=f"src_{uuid.uuid4().hex[:10]}",
                title=f"Search result for: {query}",
                url=f"https://example.com/result/{i}",
                publisher="Web Search",
                access_date=datetime.now().strftime("%Y-%m-%d"),
                relevant_passage=f"Relevant information about {query}...",
                claims_supported=[query],
                confidence=0.6,
                verification_status="pending",
            )
            results.append(source)
        self.sources.extend(results)
        return results

    def verify_source(self, source: Source) -> Source:
        """Verify a source's credibility and update its status."""
        # Placeholder - would check domain authority, recency, etc.
        source.verification_status = "verified"
        source.confidence = 0.8
        return source

    def get_sources_for_claim(self, claim: str) -> list[Source]:
        """Find sources that support a specific claim."""
        return [s for s in self.sources if claim.lower() in " ".join(s.claims_supported).lower()]